{
  "name": "blue-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/start.ts",
    "build": "bun run typecheck && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:frontend": "vite",
    "setup": "bun run scripts/setup.ts",
    "typecheck": "tsc -b && tsc -p convex/tsconfig.json",
    "test": "bun --bun ./node_modules/vitest/vitest.mjs run --pool=threads",
    "test:e2e": "bun --bun ./node_modules/@playwright/test/cli.js test",
    "build:cloudflare": "bunx --bun convex deploy --typecheck disable --cmd \"bun run build\" --cmd-url-env-var-name VITE_CONVEX_URL",
    "deploy:cloudflare": "bun --bun ./node_modules/wrangler/wrangler-dist/cli.js deploy",
    "check:cloudflare": "bun run build && bun --bun ./node_modules/wrangler/wrangler-dist/cli.js deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@auth/core": "0.41.1",
    "@base-ui/react": "^1.9.0",
    "@convex-dev/auth": "^0.0.96",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "convex": "^1.49.0",
    "lucia": "^3.2.2",
    "lucide-react": "^1.66.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.66",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  },
  "bin": {
    "blue-app": "./scripts/blue-app.ts"
  }
}
